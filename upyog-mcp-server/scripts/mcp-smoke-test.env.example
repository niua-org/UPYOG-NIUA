# UPYOG MCP smoke test configuration
#
# Setup (once):
#   cd upyog-mcp-server
#   cp scripts/mcp-smoke-test.env.example scripts/mcp-smoke-test.env
#   # Edit scripts/mcp-smoke-test.env with your UAT token and uuid (file is gitignored)
#
# Run MCP server (terminal 1):
#   cd upyog-mcp-server
#   export UPYOG_MCP_TOKEN_SECRET='local-dev-only-change-me-32chars'
#   mvn spring-boot:run
#
# Run smoke test (terminal 2):
#   cd upyog-mcp-server
#   ./scripts/run-mcp-smoke-test.sh
#
# Logs: logs/mcp-smoke-test.log (overwritten each run)

# --- Required ---
export MCP_URL='http://localhost:8088/mcp'
export MCP_AUTH_TOKEN='253ee3c7-365d-45ee-b4eb-588a539e6c6e'
export MCP_USER_UUID='f789d679-352d-4aec-8198-4d61af1e0566'

# --- Optional: tracing ---
export MCP_CORRELATION_ID='mcp-smoke-local'

# --- Optional: tenant / PGR search ---
export MCP_TENANT='pg'
export MCP_MOBILE='8010012414'

# --- Optional: property + billing (leave empty to skip) ---
export MCP_PROPERTY_ID=''
export MCP_PROPERTY_TENANT='pg.citya'

# --- Optional: write tests (default off) ---
export MCP_PGR_SERVICE_CODE='Streetlight'
export MCP_RUN_PREPARE='false'
export MCP_RUN_CONFIRM='false'
