{
  "moduleName": "employee_module",
  "description": "Challan Generation Employee flow",
  "baseUrl": "${selected.url}",
  "instructions": [
    {
      "stepName": "Enter username",
      "locatorStrategy": "NAME",
      "locatorValue": "username",
      "action": "TYPE",
      "inputValue": "${selected.username}",
      "dynamicSleep": 300
    },
    {
      "stepName": "Enter password",
      "locatorStrategy": "NAME",
      "locatorValue": "password",
      "action": "TYPE",
      "inputValue": "${selected.password}",
      "dynamicSleep": 300
    },
    {
      "stepName": "Select city from dropdown",
      "locatorStrategy": "CSS",
      "locatorValue": "input.employee-select-wrap--elipses",
      "action": "SELECT_DROPDOWN_BY_INDEX",
      "inputValue": "0:0",
      "dynamicSleep": 500
    },
    {
      "stepName": "Click Continue button",
      "locatorStrategy": "XPATH",
      "locatorValue": "//button[contains(@class, 'submit-bar') and .//header[text()='Continue']]",
      "action": "CLICK",
      "inputValue": null,
      "dynamicSleep": 2000
    },
    {
      "stepName": "Navigate to Estate Management",
      "locatorStrategy": "XPATH",
      "locatorValue": "//a[@href='/upyog-ui/employee/challangeneration/generate-challan']",
      "action": "CLICK_JS",
      "dynamicSleep": 2000
    },
    {
      "stepName": "Offender Mobile Number",
      "locatorStrategy": "LABEL",
      "locatorValue": "Mobile No.",
      "action": "TYPE_BY_LABEL",
      "inputValue": "${mobile.number}",
      "dynamicSleep": 2000
    },
    {
      "stepName": "Enter Address",
      "locatorStrategy": "XPATH",
      "locatorValue": "//h2[contains(normalize-space(),'Address')]/following::textarea[1]",
      "action": "TYPE",
      "inputValue": "${address.line1}",
      "dynamicSleep": 2000
    },
    {
      "stepName": "Offence Category",
      "locatorStrategy": "CSS",
      "locatorValue": "div.select svg.cp",
      "action": "SELECT_DROPDOWN_BY_INDEX",
      "inputValue": "0:0",
      "dynamicSleep": 2000
    },
    {
      "stepName": "Offence Subcategory",
      "locatorStrategy": "CSS",
      "locatorValue": "div.select svg.cp",
      "action": "SELECT_DROPDOWN_BY_INDEX",
      "inputValue": "1:0",
      "dynamicSleep": 2000
    },
    {
      "stepName": "Type of Offence / Violation",
      "locatorStrategy": "CSS",
      "locatorValue": "div.select svg.cp",
      "action": "SELECT_DROPDOWN_BY_INDEX",
      "inputValue": "2:0",
      "dynamicSleep": 2000
    },
    {
      "stepName": "Upload Citizen Request Letter ",
      "locatorStrategy": "XPATH",
      "locatorValue": "(//input[@type='file'])[1]",
      "action": "UPLOAD_FILE",
      "inputValue": "${document.common.png}",
      "dynamicSleep": 1000
    },
    {
      "stepName": "Upload Allotment Letter",
      "locatorStrategy": "XPATH",
      "locatorValue": "(//input[@type='file'])[2]",
      "action": "UPLOAD_FILE",
      "inputValue": "${document.common.proof}",
      "dynamicSleep": 1000
    },
    {
      "stepName": "Submit application",
      "locatorStrategy": "XPATH",
      "locatorValue": "//button[@class='submit' and @type='button'][.//header[text()='Submit']]",
      "action": "CLICK",
      "inputValue": null,
      "dynamicSleep": 2000
    },
    {
      "stepName": "Capture Application Number",
      "locatorStrategy": "XPATH",
      "locatorValue": "//*[contains(text(),'Challan Number') or contains(text(),'Application Number')]/following-sibling::*[1]",
      "action": "CAPTURE_TEXT",
      "inputValue": "APPLICATION_NO",
      "dynamicSleep": 3000
    }
  ]
}